{
  "name": "chrome-ext-language",
  "version": "1.0.0",
  "description": "A basic Chrome extension template",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "clean": "rm -rf dist/*",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "npm run build && mkdir -p release && VERSION=$(node -e \"console.log(require('./src/manifest.json').version)\") && rm -f release/ja-$VERSION.zip && cd dist && zip -r ../release/ja-$VERSION.zip . && echo \"Packaged: release/ja-$VERSION.zip\""
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.9.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "main": "background.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase": "^12.7.0",
    "firebase-functions": "^7.0.2",
    "marked": "^15.0.8"
  }
}
